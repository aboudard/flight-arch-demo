{
  "name": "flight-arch-demo",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "lint": "ng lint",
    "sheriff:verify": "sheriff verify",
    "sheriff:list": "sheriff list",
    "test:arch": "vitest run --config vitest.arch.config.mts",
    "check": "node scripts/run-checks.mjs",
    "check:full": "node scripts/run-checks.mjs --full",
    "detective": "detective",
    "detective:demo": "detective --demo",
    "skills:sync": "node scripts/copy-skills.mjs",
    "prepare": "node scripts/copy-skills.mjs",
    "demo:break-domain": "node scripts/demo/scenario.mjs break-domain",
    "demo:break-layer": "node scripts/demo/scenario.mjs break-layer",
    "demo:break-naming": "node scripts/demo/scenario.mjs break-naming",
    "demo:reset": "node scripts/demo/scenario.mjs reset",
    "sandcastle": "tsx .sandcastle/main.mts",
    "tickets": "node scripts/tickets.mjs list",
    "check:quiet": "node scripts/run-checks.mjs --quiet",
    "check:full:quiet": "node scripts/run-checks.mjs --full --quiet",
    "sandcastle:smoke": "tsx .sandcastle/main.mts --only=002",
    "sandcastle:build-image": "sandcastle docker build-image"
  },
  "private": true,
  "packageManager": "npm@10.9.9",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@ngrx/signals": "^22.0.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@ai-hero/sandcastle": "^0.12.0",
    "@angular/build": "^22.2.4",
    "@angular/cli": "^22.2.4",
    "@angular/compiler-cli": "^22.2.0",
    "@eslint/js": "^10.0.1",
    "@softarc/detective": "^2.1.2",
    "@softarc/eslint-plugin-sheriff": "^0.20.0",
    "@softarc/sheriff-core": "^0.20.0",
    "@types/node": "^22.20.5",
    "angular-eslint": "22.6.0",
    "archunit": "^2.5.4",
    "eslint": "^10.12.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.71.0",
    "vitest": "^5.0.0"
  }
}
